<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDescription</key>
			<string>設定取用限制</string>
			<key>PayloadDisplayName</key>
			<string>取用限制</string>
			<key>PayloadIdentifier</key>
			<string>tw.edu.example.nanomdm.baseline.restrictions</string>
			<key>PayloadType</key>
			<string>com.apple.applicationaccess</string>
			<key>PayloadUUID</key>
			<string>F990DB81-FF16-446B-A251-3790BA5B1012</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>allowAddingGameCenterFriends</key>
			<true/>
			<key>allowAppInstallation</key>
			<true/>
			<key>allowAppRemoval</key>
			<true/>
			<key>allowApplePersonalizedAdvertising</key>
			<false/>
			<key>allowAssistant</key>
			<true/>
			<key>allowAutoUnlock</key>
			<false/>
			<key>allowBookstoreErotica</key>
			<true/>
			<key>allowCamera</key>
			<true/>
			<key>allowCloudBackup</key>
			<true/>
			<key>allowCloudPhotoLibrary</key>
			<false/>
			<key>allowDeviceNameModification</key>
			<true/>
			<key>allowDiagnosticSubmission</key>
			<false/>
			<key>allowEnablingRestrictions</key>
			<true/>
			<key>allowEraseContentAndSettings</key>
			<true/>
			<key>allowExplicitContent</key>
			<true/>
			<key>allowFindMyDevice</key>
			<false/>
			<key>allowFindMyFriends</key>
			<false/>
			<key>allowGameCenter</key>
			<false/>
			<key>allowInAppPurchases</key>
			<false/>
			<key>allowMultiplayerGaming</key>
			<true/>
			<key>allowPasscodeModification</key>
			<true/>
			<key>allowScreenShot</key>
			<true/>
			<key>allowSystemAppRemoval</key>
			<true/>
			<key>allowUIAppInstallation</key>
			<true/>
			<key>forceAutomaticDateAndTime</key>
			<true/>
			<key>forceClassroomAutomaticallyJoinClasses</key>
			<true/>
			<key>forceClassroomUnpromptedAppAndDeviceLock</key>
			<true/>
			<key>forceClassroomUnpromptedScreenObservation</key>
			<true/>
			<key>forceLimitAdTracking</key>
			<true/>
			<key>forceWiFiPowerOn</key>
			<true/>
		</dict>
		<dict>
			<key>AutoJoin</key>
			<true/>
			<key>DisableAssociationMACRandomization</key>
			<true/>
			<!-- 這裡原本是開放式Wi-Fi(EncryptionType:None,沒有密碼)。
			     如果你要用的Wi-Fi有密碼,記得補上EncryptionType(例如WPA2)跟Password欄位 -->
			<key>EncryptionType</key>
			<string>None</string>
			<key>HIDDEN_NETWORK</key>
			<false/>
			<key>PayloadDescription</key>
			<string>配置 Wi-Fi 設定</string>
			<key>PayloadDisplayName</key>
			<string>Wi-Fi (YOUR_SSID_HERE)</string>
			<key>PayloadIdentifier</key>
			<string>tw.edu.example.nanomdm.baseline.wifi.0</string>
			<key>PayloadType</key>
			<string>com.apple.wifi.managed</string>
			<key>PayloadUUID</key>
			<string>822C6C13-D744-445C-8A07-6D7706034DB7</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>SSID_STR</key>
			<string>YOUR_SSID_HERE</string>
		</dict>
		<dict>
			<key>FullScreen</key>
			<false/>
			<key>IsRemovable</key>
			<true/>
			<key>Label</key>
			<string>YOUR_SCHOOL_NAME</string>
			<key>PayloadDescription</key>
			<string>配置 Web Clip 設定</string>
			<key>PayloadDisplayName</key>
			<string>YOUR_SCHOOL_NAME</string>
			<key>PayloadIdentifier</key>
			<string>tw.edu.example.nanomdm.baseline.webclip.0</string>
			<key>PayloadType</key>
			<string>com.apple.webClip.managed</string>
			<key>PayloadUUID</key>
			<string>6783EDA5-E674-40FC-A106-FE99660BC28E</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>Precomposed</key>
			<false/>
			<key>URL</key>
			<string>https://YOUR_SCHOOL_WEBSITE_HERE/</string>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>iPad 基礎設定（Wi-Fi、Web Clip、取用限制）</string>
	<key>PayloadDisplayName</key>
	<string>Baseline Settings</string>
	<key>PayloadIdentifier</key>
	<string>tw.edu.example.nanomdm.baseline</string>
	<key>PayloadOrganization</key>
	<string>YOUR_SCHOOL_NAME</string>
	<key>PayloadRemovalDisallowed</key>
	<true/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>AB75FC61-C09B-46AE-B9CA-B22E901CD533</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
