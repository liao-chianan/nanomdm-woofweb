# =============================================================================
# NanoMDM WebUI 部署設定範本
# 複製這份檔案為 .env,把下面標示 <請填入...> 的地方換成你自己的實際值
# 複製指令: cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# nanomdm (MDM 核心服務)
# -----------------------------------------------------------------------------
# API 金鑰,自己隨機產生一組高強度字串即可,不需要跟任何外部服務對應
# 產生範例: openssl rand -base64 32
NANOMDM_API_KEY=<請填入nanomdm的API金鑰>

# webui 直接呼叫nanomdm API用的位址。如果webui2跟nanomdm-server部署在同一台主機、
# 透過docker-compose的127.0.0.1 port mapping對外,通常維持這個預設值即可,不需要改成對外網域
NANOMDM_BASE_URL=http://127.0.0.1:9000

# nanomdm用的MySQL資料庫密碼(對應docker-compose.yml裡mysql服務建立的nanomdm帳號密碼)
NANOMDM_DB_PASSWORD=<請填入nanomdm資料庫密碼>


# -----------------------------------------------------------------------------
# nanodep (DEP/ADE 裝置指派服務)
# -----------------------------------------------------------------------------
NANODEP_API_KEY=<請填入nanodep的API金鑰>
NANODEP_BASE_URL=http://127.0.0.1:9001

# 你在nanodep裡設定的DEP名稱(對應nanodep-syncer、dep-account-detail.sh等工具用的-name參數)
NANODEP_NAME=<請填入你的DEP名稱,例如school>

NANODEP_DB_PASSWORD=<請填入nanodep資料庫密碼>

# webui透過「群組註冊檔-套用」功能改派裝置後,需要重啟nanodep-syncer.service才會讓
# Apple那邊的指派狀態即時反映到本地資料庫。這裡填完整的重啟指令,例如:
# sudo systemctl restart nanodep-syncer.service
# 沒有填的話,套用功能還是會執行,只是不會自動重啟這個服務,需要自己手動重啟
NANODEP_DEPSYNCER_RESTART_CMD=<請填入nanodep-syncer的重啟指令,或留空>


# -----------------------------------------------------------------------------
# nanoaxm (新版Apple Business/School Manager API服務)
# -----------------------------------------------------------------------------
NANOAXM_API_KEY=<請填入nanoaxm的API金鑰>
NANOAXM_BASE_URL=http://127.0.0.1:9005

# 你在nanoaxm裡設定的名稱(對應cfg-authcreds.sh等工具用的-name參數)
NANOAXM_NAME=<請填入你的AXM名稱,例如school>

NANOAXM_DB_PASSWORD=<請填入nanoaxm資料庫密碼>


# -----------------------------------------------------------------------------
# MySQL (docker-compose.yml裡mysql服務用)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=<請填入MySQL root密碼>


# -----------------------------------------------------------------------------
# SCEP (裝置身分憑證簽發服務)
# -----------------------------------------------------------------------------
# SCEP挑戰密碼,裝置註冊時要提出這組密碼才能拿到身分憑證。
# 重要:這個值必須跟 mobileconfig/enroll-template.mobileconfig 裡SCEP Payload的
# Challenge欄位完全一致,兩邊各自獨立設定,對不上的話裝置註冊會直接失敗
SCEP_CHALLENGE=<請填入SCEP挑戰密碼,建議用亂數字串>

# SCEP根CA私鑰的加密密碼。初次建立CA時(ca -init -key-password ...)跟之後webui
# 「重新產生SCEP根CA」功能都會用到這組密碼,必須維持一致,中途換掉會讓nanomdm-scep
# 服務沒辦法解密既有的CA私鑰而啟動失敗
SCEP_CA_PASSWORD=<請填入SCEP CA私鑰密碼,建議用亂數字串>


# -----------------------------------------------------------------------------
# 學校識別資訊(選填,用於遺失模式(Lost Mode)指令的螢幕顯示訊息預設值)
# -----------------------------------------------------------------------------
# 不填的話,「啟用遺失尋找模式」指令的訊息/電話欄位預設值會是空白,
# 每次下指令時需要自己手動輸入,不影響其他功能運作
SCHOOL_NAME=<請填入學校名稱,例如：範例國小>
SCHOOL_PHONE=<請填入聯絡電話>


# -----------------------------------------------------------------------------
# 選填:覆寫特定路徑(不填就用程式內建的預設值)
# 注意:如果你的實際檔名/路徑跟下面預設值不一樣(例如沿用舊版命名慣例的既有檔案),
# 這裡就不是「錦上添花」的選填,而是必填,不填的話對應功能會找不到檔案而失敗
# -----------------------------------------------------------------------------
# nginx的Let's Encrypt憑證實際路徑,預設用/etc/letsencrypt/live/<你的網域>/fullchain.pem
# 這個變數只有在你的nginx憑證路徑不是標準Let's Encrypt慣例時才需要填
# NGINX_CERT_PATH=/etc/letsencrypt/live/你的網域/fullchain.pem

# VPP Content Token檔案的實際路徑,預設是/opt/nanomdm-deployment/vpp_token.vpptoken
# 這個變數只有在你想把VPP Token放在別的檔名/路徑時才需要填,
# webui的config.py跟webhook-server.py都會讀這同一個變數,不用兩邊分別設定
# VPP_TOKEN_PATH=/opt/nanomdm-deployment/vpp_token.vpptoken
